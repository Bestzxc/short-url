<mxfile host="app.diagrams.net"><diagram id="dfd0" name="DFD Level 0"><mxGraphModel dx="1900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DFD Level 0 (Context Diagram) – ระบบ Short URL" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="540" y="20" width="800" height="40" as="geometry"/></mxCell><mxCell id="proc" value="&lt;b&gt;0&lt;/b&gt;&lt;hr&gt;&lt;b style=&quot;font-size:22px&quot;&gt;ระบบ Short URL&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="640" y="100" width="600" height="600" as="geometry"/></mxCell><mxCell id="user" value="เจ้าของลิงก์&lt;br&gt;(User)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="200" height="560" as="geometry"/></mxCell><mxCell id="visitor" value="ผู้เข้าชมลิงก์&lt;br&gt;(Visitor)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1640" y="120" width="200" height="560" as="geometry"/></mxCell><mxCell id="f1" value="1. ข้อมูลสมัครสมาชิก / ล็อกอิน (email, password)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=1;exitY=0.0714;exitDx=0;exitDy=0;entryX=0.2000;entryY=0.1000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="user" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="2. ผลการล็อกอิน (JWT ใน httpOnly cookie)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.1000;exitY=0.2000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.1786;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="3. URL ต้นฉบับ + ตัวเลือกลิงก์&lt;br&gt;(custom alias, วันหมดอายุ, จำนวนคลิกสูงสุด, รหัสผ่านลิงก์)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=1;exitY=0.2857;exitDx=0;exitDy=0;entryX=0.0417;entryY=0.3000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="user" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="4. Short URL ที่สร้างแล้ว" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.0101;exitY=0.4000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3929;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="5. คำขอ QR Code (short code)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=1;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="user" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="6. QR Code (รูปภาพ PNG)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.0101;exitY=0.6000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.6071;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f7" value="7. คำขอดูประวัติ / สถิติ" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=1;exitY=0.7143;exitDx=0;exitDy=0;entryX=0.0417;entryY=0.7000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="user" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f8" value="8. รายการประวัติ (URL ต้นฉบับ, Short URL)&lt;br&gt;และสถิติการคลิก" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.1000;exitY=0.8000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.8214;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f9" value="9. ข้อมูลจัดการลิงก์ (สถานะเปิด/ปิด, ลบลิงก์)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=1;exitY=0.9286;exitDx=0;exitDy=0;entryX=0.2000;entryY=0.9000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="user" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f10" value="10. คำขอเปิด Short URL&lt;br&gt;(short code, ข้อมูลอุปกรณ์)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=0;exitY=0.2321;exitDx=0;exitDy=0;entryX=0.9330;entryY=0.2500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="visitor" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f11" value="11. หน้ากรอกรหัสผ่านลิงก์ (ถ้าตั้งไว้)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.9841;exitY=0.3750;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.3661;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="visitor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f12" value="12. รหัสผ่านลิงก์" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#1f4e79;fontColor=#1f4e79;exitX=0;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="visitor" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f13" value="13. Redirect ไปยัง URL ต้นฉบับ" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.9841;exitY=0.6250;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.6339;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="visitor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f14" value="14. หน้าแจ้งสถานะ&lt;br&gt;(ไม่พบ / ถูกปิด / หมดอายุ / คลิกครบแล้ว)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;strokeColor=#2e7d32;fontColor=#2e7d32;exitX=0.9330;exitY=0.7500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.7679;entryDx=0;entryDy=0;" edge="1" parent="1" source="proc" target="visitor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;สัญลักษณ์&lt;/b&gt;&lt;br&gt;○ วงกลม = Process (ระบบ)&lt;br&gt;▭ สี่เหลี่ยม = External Entity&lt;br&gt;&lt;font color=&quot;#1f4e79&quot;&gt;━▶ สีน้ำเงิน = ข้อมูลเข้าระบบ&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;━▶ สีเขียว = ข้อมูลออกจากระบบ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;strokeColor=#999999;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>