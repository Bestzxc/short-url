{
  "name": "ziplink-backend",
  "version": "1.0.0",
  "description": "ZipLink REST API + redirect service (Express + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node db/migrate.js",
    "test": "node --test --test-concurrency=1 test/unit.test.js test/api.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text-summary node --test --test-concurrency=1 test/unit.test.js test/api.test.js && node scripts/lcov-for-sonar.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
