# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Shared with the API service — both read/write the same `links` and `clicks` tables.
DATABASE_URL=mysql://root:password@localhost:3306/short_url
# Set to true for hosted MySQL (Aiven, TiDB Cloud)
DB_SSL=false
# Aiven only: CA certificate PEM (use \n for line breaks on one line)
DB_CA_CERT=

# Where the Next.js frontend runs; visitors are sent here for /status/<state> and /unlock/<code>
FRONTEND_URL=http://localhost:3000

PORT=4002
