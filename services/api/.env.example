# MySQL connection string: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Shared with the redirect service — both read/write the same `links` and `clicks` tables.
DATABASE_URL=mysql://root:password@localhost:3306/short_url
# Set to true for hosted MySQL (Aiven, TiDB Cloud)
DB_SSL=false
# Aiven only: CA certificate PEM (use \n for line breaks on one line)
DB_CA_CERT=

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the Next.js frontend runs (CORS)
FRONTEND_URL=http://localhost:3000
# Public URL of the redirect service; short links and QR codes are built from it
REDIRECT_BASE_URL=http://localhost:4002

PORT=4000
# NODE_ENV=production   # enables Secure cookies (required on HTTPS hosts)
